{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "MigrateOnStartup": false,
    "SeedOnStartup": false
  },
  "BookingPolicy": {
    "MinimumNoticeMinutes": 60,
    "MaxAdvanceDays": 30,
    "ChangeCutoffHours": 2,
    "MaxReschedules": 3
  }
}
