# Normalise line endings; shell scripts and Dockerfiles must stay LF on Windows checkouts.
* text=auto eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
Dockerfile* text eol=lf
*.Dockerfile text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
