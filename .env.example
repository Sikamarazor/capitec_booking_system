# Copy to .env and edit. Never commit .env.
POSTGRES_USER=branchbooking
POSTGRES_DB=branchbooking
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432

# Used from WI-105 onward
API_PORT=5080
WEB_PORT=8080


# Notifications. Simulated (the default) sends nothing and keeps the message text for the demo.
NOTIFICATIONS_CHANNEL=Simulated
# Where the web app is reachable by customers; used for the link in messages.
PUBLIC_BASE_URL=http://localhost:8080

