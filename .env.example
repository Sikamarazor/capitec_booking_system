# Copy to .env and edit. Never commit .env.
POSTGRES_USER=branchbooking
POSTGRES_DB=branchbooking
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432

# Used from WI-105 onward
API_PORT=5080
WEB_PORT=8080


# Notifications. Simulated (the default) sends nothing and keeps the message text for the demo.
NOTIFICATIONS_CHANNEL=Simulated
# Where the web app is reachable by customers; used for the link in messages.
PUBLIC_BASE_URL=http://localhost:8080


# Email over SMTP. Leave these alone while NOTIFICATIONS_CHANNEL=Simulated.
# To see the emails in Mailpit: set NOTIFICATIONS_CHANNEL=Smtp, then run: docker compose --profile mail up -d
# (the defaults below already point at the mailpit service; open http://localhost:8025)
# For a real SMTP server set all of them; never commit real values (.env is git-ignored).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURITY=None
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=noreply@branchbooking.example
SMTP_SENDER_NAME=BranchBooking


# Reminder emails about a day before an appointment. Set to false to turn them off.
REMINDERS_ENABLED=true
# Hours a booking must be left alone before it is reminded (0 is useful for a demo).
REMINDERS_GAP_HOURS=4

SOME_NEW_SETTING=1